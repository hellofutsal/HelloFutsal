meta {
  name: UpdateFieldInventory
  type: http
  seq: 3
}

patch {
  url: {{development}}/fields/{{fieldId}}/inventory
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "inventory": {
      "water": 20,
      "coke": 30,
      "chips": 50
    }
  }
}