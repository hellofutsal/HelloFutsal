meta {
  name: CreateTournament
  type: http
  seq: 1
}

post {
  url: {{development}}/tournaments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "organizerName": "ABC College",
    "organizerPhone": "+919800000000",
    "eventName": "Inter College Cup",
    "startDate": "2026-05-17",
    "endDate": "2026-05-18",
    "startTime": "06:00",
    "endTime": "09:00",
    "courts": ["{{fieldId}}"],
    "totalAmount": "60000",
    "advancePaid": "30000",
    "notes": "8 teams, knockout format"
  }
}
